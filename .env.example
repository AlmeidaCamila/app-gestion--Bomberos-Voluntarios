# Panel del proyecto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key: NUNCA exponer al cliente. Solo se usa en
# Server Actions / route handlers (creación de usuarios, admin).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Dominio sintético usado para mapear legajo -> email interno de Supabase Auth
AUTH_EMAIL_DOMAIN=cuartel.local
